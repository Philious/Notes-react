{
  "name": "notes",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json --composite false",
    "backend": "cd backend && npm run start && cd ..",
    "start": "npm run backend && npm run build && npm run preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.1",
    "styled-components": "^6.1.14",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.8.4",
    "@types/react-dom": "^18.3.1",
    "@types/react": "^18.3.18",
    "@vitejs/plugin-react": "^4.3.2",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint-plugin-react": "^7.37.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "sass-embedded": "^1.83.1",
    "typescript-eslint": "^8.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
