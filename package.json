{
  "name": "notes",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json --composite false",
    "backend": "cd backend && npm run start && cd ..",
    "start": "npm run backend && npm run build && npm run preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.25.1",
    "styled-components": "^6.1.13",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.8.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.2",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "express": "^4.21.1",
    "sass": "^1.79.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
